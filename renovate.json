{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group @girs typelibs that usually ship together",
      "matchPackageNames": ["@girs/**"],
      "groupName": "girs"
    },
    {
      "description": "Group ESLint-related npm packages",
      "matchPackageNames": ["eslint", "@eslint/**", "typescript-eslint"],
      "groupName": "eslint"
    },
    {
      "description": "Group GitHub Actions updates (actions.lock is regenerated by Renovate)",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
