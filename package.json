  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@girs/adw-1": "5.6.0",
    "@girs/gdk-4.0": "5.6.0",
    "@girs/gjs": "5.6.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gtk-4.0": "5.6.0",
    "@girs/soup-3.0": "5.6.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
