    "lint": "eslint .",
    "test": "bun test",
    "build": "tsc",
    "pack": "bun scripts/pack.ts",
    "dev": "bun scripts/dev.ts",
    "dev:prefs": "bun scripts/dev-prefs.ts",
    "install:local": "bun scripts/install.ts",
    "clean": "bun scripts/clean.ts",
    "publish:ego": "bun scripts/publish-ego.ts"
  },
  "overrides": {
    "@girs/gio-2.0": "5.6.0",
    "@girs/gobject-2.0": "5.6.0"
