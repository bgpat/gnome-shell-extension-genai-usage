{
  "name": "gnome-shell-extension-genai-usage",
  "version": "0.1.0",
  "private": true,
  "description": "GNOME Shell extension that shows ChatGPT and Cursor usage quotas",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgpat/gnome-shell-extension-genai-usage.git"
  },
  "scripts": {
